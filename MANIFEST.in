recursive-include pythia *.py
recursive-include pythia/ui/desktop/web *
recursive-include pythia/ui/bigpicture/qml *
recursive-include share *
include bin/pythia
include native/Cargo.toml native/Cargo.lock native/build.rs native/rustfmt.toml
recursive-include native/src *.rs
include LICENSE
include AUTHORS
include MANIFEST.in
include README.rst
graft debian
prune tests
global-exclude __pycache__ *.pyc
