"""Main entry point for Pythia"""

import gettext
import locale
import multiprocessing
import os
import sys
from os.path import dirname, normpath, realpath

# Python 3.14 changes the default to 'forkserver' which is very different;
# let's not put up with _that_! (Windows has no fork start method at all --
# real, separate gap, not addressed here; this only matters on POSIX.)
if hasattr(os, "fork"):
    multiprocessing.set_start_method("fork")

LAUNCH_PATH = dirname(realpath(__file__))

# Prevent loading Python modules from home folder
# They can interfere with Pythia and prevent it
# from working.
if os.environ.get("PYTHIA_ALLOW_LOCAL_PYTHON_PACKAGES") != "1":
    sys.path = [path for path in sys.path if not path.startswith("/home") and not path.startswith("/var/home")]

if os.path.isdir(os.path.join(LAUNCH_PATH, "../pythia")):
    sys.dont_write_bytecode = True
    SOURCE_PATH = normpath(os.path.join(LAUNCH_PATH, ".."))
    sys.path.insert(0, SOURCE_PATH)
else:
    sys.path.insert(0, os.path.normpath(os.path.join(LAUNCH_PATH, "../lib/pythia")))

try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error as ex:
    sys.stderr.write("Unsupported locale setting: %s\n" % ex)

try:
    # optional_settings does not exist if you don't use the meson build system
    from pythia import optional_settings  # type: ignore

    try:
        locale.bindtextdomain("pythia", optional_settings.LOCALE_DIR)
        gettext.bindtextdomain("pythia", optional_settings.LOCALE_DIR)
        locale.textdomain("pythia")
        gettext.textdomain("pythia")
    except Exception as ex:
        sys.stderr.write(
            "Couldn't bind gettext domain, translations won't work.\n"
            "LOCALE_DIR: %s\nError: %s\n" % (optional_settings.LOCALE_DIR, ex)
        )
except ImportError:
    pass

if "WEBKIT_DISABLE_DMABUF_RENDERER" not in os.environ:
    os.environ["WEBKIT_DISABLE_DMABUF_RENDERER"] = "1"

# GTK removal (2026-08-04): pythia.gui (GTK) is gone. Any real CLI flag
# (list/install/export/exec/...) always goes through the headless entry
# point, same as before -- scripting shouldn't need a display. Bare
# `pythia` with no arguments tries the new Qt UI if PySide6 is installed,
# since that's the only case that actually wants a window.
if len(sys.argv) == 1:
    try:
        from pythia.ui.app import main as qt_main

        qt_main()
    except ImportError as ex:
        sys.stderr.write(f"Qt UI unavailable ({ex}), falling back to the headless CLI.\n")
        from pythia.app import main

        main()
else:
    from pythia.app import main

    main()
